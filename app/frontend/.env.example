# Base URL of the API, embedded into the JavaScript bundle at BUILD time (npm run build).
# Keep the default "/api" when a reverse proxy (NGINX / Gateway API) serves the frontend and
# forwards /api/* to the Go API. Use a full URL only if the API lives on another origin,
# e.g. VITE_API_URL=http://192.168.160.50:8080/api
VITE_API_URL=/api
