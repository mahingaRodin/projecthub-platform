# Copy to .env for local development:   cp .env.example .env
# The API loads .env from its working directory (the backend/ folder) at startup. Variables set in the
# real environment (docker compose "environment:", Kubernetes env/ConfigMap/Secret) take precedence.

# Port the Gin server listens on
PORT=8080

# MongoDB connection string and database name
#   docker compose: mongodb://<user>:<password>@mongodb:27017/?authSource=admin
#   kubernetes:     mongodb://<user>:<password>@mongodb-0.mongodb.<namespace>.svc.cluster.local:27017/?authSource=admin
MONGO_URI=mongodb://localhost:27017
MONGO_DB=projecthub
# How long to keep retrying the initial MongoDB connection before exiting
MONGO_CONNECT_TIMEOUT=30s

# REQUIRED — HMAC secret used to sign JWTs (min. 32 characters). Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
# Token lifetime (Go duration: 15m, 8h, 24h ...)
JWT_EXPIRES_IN=24h

# Comma-separated list of browser origins allowed to call the API directly ("*" = any).
# Not needed when NGINX serves the frontend and the API on the same origin.
CORS_ORIGINS=http://localhost:5173

# Valkey cache (optional: if Valkey is unreachable the API keeps working and reads from MongoDB)
#   docker compose: VALKEY_ADDR=valkey:6379      kubernetes: VALKEY_ADDR=valkey.<namespace>.svc.cluster.local:6379
CACHE_ENABLED=true
VALKEY_ADDR=localhost:6379
VALKEY_PASSWORD=change-me
VALKEY_DB=0
# How long cached values live (Go duration: 30s, 2m, 1h)
CACHE_STATS_TTL=2m
CACHE_USER_TTL=1m

# Create the test accounts and a sample project on the first start (empty database)
SEED_ENABLED=true

# Gin mode: debug | release
GIN_MODE=release
